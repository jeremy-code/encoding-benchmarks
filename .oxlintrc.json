{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "unicorn",
    "typescript",
    "oxc",
    "import",
    "jsdoc",
    "vitest",
    "promise",
    "node"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "vitest/consistent-test-it": "warn"
  },
  "env": {
    "builtin": true
  },
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "warn",
    "typeAware": true,
    "typeCheck": true
  }
}
